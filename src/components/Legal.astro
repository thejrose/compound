---
interface Props { title: string; updated: string; }
const { title, updated } = Astro.props;
---
<section class="section">
  <div class="wrap stack-l">
    <div class="placeholder"><strong>Draft for review.</strong> This page is a starting template, not legal advice. Fill in the [bracketed] details and have it checked before launch.</div>
    <div class="stack">
      <span class="label">Last updated {updated}</span>
      <h1>{title}<span class="dot">.</span></h1>
    </div>
    <div class="prose"><slot /></div>
  </div>
</section>
