---
interface Props { eyebrow: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <div class="wrap ph-inner">
    <div class="stack-m">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot name="actions" />
    </div>
    <slot />
  </div>
</section>
<style>
  .page-hero { padding-block: clamp(56px, 8vw, 104px) clamp(48px, 6vw, 80px); background: radial-gradient(900px 420px at 90% 0%, var(--bond-soft), transparent 60%), #fff; border-bottom: 1px solid var(--line); }
  .ph-inner { display: grid; gap: clamp(32px, 5vw, 72px); grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: center; }
  .ph-inner:not(:has(> :nth-child(2))) { grid-template-columns: minmax(0, 860px); }
  @media (max-width: 900px) { .ph-inner { grid-template-columns: 1fr; } }
</style>
