---
// Margin waterfall: where each £100 of net revenue goes. Example data.
const steps = [
  { name: 'Net revenue', v: 100, base: 0, kind: 'total' },
  { name: 'Product cost', v: -42, base: 58, kind: 'cost' },
  { name: 'Fulfilment', v: -11, base: 47, kind: 'cost' },
  { name: 'Payment & returns', v: -6, base: 41, kind: 'cost' },
  { name: 'CM2', v: 41, base: 0, kind: 'sub' },
  { name: 'Paid marketing', v: -24, base: 17, kind: 'cost' },
  { name: 'CM3', v: 17, base: 0, kind: 'total2' },
];
const H = 170;
---
<div class="mw">
  <div class="mw-head"><span class="label">Where £100 of revenue goes</span><span class="label">CM3 17%</span></div>
  <div class="mw-chart" role="img" aria-label="Example margin waterfall: from £100 net revenue, product cost, fulfilment, payment and returns, and marketing leave £17 contribution.">
    {steps.map((s) => (
      <div class="mw-col">
        <span class="mw-val">{s.v > 0 ? `£${s.v}` : `−£${-s.v}`}</span>
        <div class="mw-track" style={`height:${H}px`}>
          <i class={`k-${s.kind}`} style={`height:${(Math.abs(s.v) / 100) * H}px;bottom:${(s.base / 100) * H}px`}></i>
        </div>
        <span class="mw-name">{s.name}</span>
      </div>
    ))}
  </div>
</div>
<style>
  .mw { display: grid; gap: 14px; }
  .mw-head { display: flex; justify-content: space-between; }
  .mw-chart { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; align-items: end; }
  .mw-col { display: grid; gap: 6px; justify-items: center; text-align: center; }
  .mw-val { font: 500 11.5px var(--font-mono); color: var(--ink-2); }
  .mw-track { position: relative; width: 100%; border-bottom: 1px solid var(--line); }
  .mw-track i { position: absolute; left: 12%; right: 12%; border-radius: 4px; }
  .k-total { background: var(--bond); } .k-cost { background: #F7C9A0; } .k-sub { background: var(--bond); } .k-total2 { background: var(--block); }
  .mw-name { font-size: 11.5px; line-height: 1.25; color: var(--ink-muted); min-height: 2.5em; }
</style>
