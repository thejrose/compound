---
import TrustPanel from './TrustPanel.astro';
import LtvChart from './LtvChart.astro';
---
<div class="hv" role="group" aria-label="Example of a compound. growth diagnostic">
  <div class="hv-main">
    <span class="example-tag">Example data</span>
    <div class="hv-top">
      <div><span class="label">Growth diagnostic</span><p class="hv-title">Example brand · 24 months</p></div>
    </div>
    <LtvChart />
  </div>
  <div class="hv-float hv-trust"><TrustPanel compact /></div>
  <div class="hv-float hv-block">
    <span class="label">Top block</span>
    <p class="hv-bt">Fix delivery messaging at checkout</p>
    <div class="hv-meta"><span class="chip" data-stage="block">£120k / yr</span><span class="hv-bonds"><span class="mol" aria-hidden="true"><span class="n" data-stage="bond"></span><span class="b"></span><span class="n" data-stage="bond"></span><span class="b"></span><span class="n" data-stage="bond"></span></span>3 bonds</span></div>
  </div>
</div>
<style>
  .hv { position: relative; padding: 0 0 290px 72px; }
  .hv-main { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--r-3); box-shadow: var(--shadow-3); padding: 28px; display: grid; gap: 18px; }
  .hv-title { font: 400 22px/1.2 var(--font-display); margin-top: 6px; }
  .hv-float { position: absolute; background: #fff; border: 1px solid var(--line); border-radius: var(--r-2); box-shadow: var(--shadow-3); padding: 20px; }
  .hv-trust { left: 0; bottom: 0; width: 340px; }
  .hv-block { right: -12px; bottom: 170px; width: 260px; display: grid; gap: 8px; }
  .hv-bt { font-weight: 600; line-height: 1.35; }
  .hv-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .hv-bonds { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--ink-muted); }
  .hv-bonds .mol { --mol-node: 9px; --mol-bond: 10px; --mol-line: 1.5px; }
  @media (max-width: 1100px) { .hv-block { right: 0; } }
  @media (max-width: 960px) { .hv { padding: 0 0 0 0; display: grid; gap: 16px; } .hv-float { position: static; width: auto; } }
</style>
