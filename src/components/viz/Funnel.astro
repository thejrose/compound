---
// Checkout funnel with the biggest drop-off highlighted. Example data.
const steps = [
  { name: 'Product views', v: 100 }, { name: 'Add to basket', v: 11.2 }, { name: 'Checkout', v: 6.4 },
  { name: 'Shipping step', v: 3.9 }, { name: 'Purchase', v: 2.1 },
];
const worst = 3; // shipping step -> purchase... flagged on the shipping step drop
---
<div class="fun">
  <div class="fun-head"><span class="label">Checkout funnel</span><span class="label">% of sessions</span></div>
  {steps.map((s, i) => (
    <div class:list={['fun-row', { warn: i === worst }]}>
      <span class="fun-name">{s.name}</span>
      <span class="fun-bar"><i style={`width:${Math.max(s.v, 2.5)}%`}></i></span>
      <b>{s.v}%</b>
    </div>
  ))}
  <p class="fun-note"><span class="marker"></span>39% of shoppers who reach the shipping step leave. Customer voice: “delivery cost”.</p>
</div>
<style>
  .fun { display: grid; gap: 12px; font-size: 13.5px; }
  .fun-head { display: flex; justify-content: space-between; }
  .fun-row { display: grid; grid-template-columns: 110px 1fr 46px; gap: 12px; align-items: center; color: var(--ink-2); }
  .fun-row b { font: 500 12.5px var(--font-mono); text-align: right; }
  .fun-bar { height: 12px; background: var(--line-soft); border-radius: 99px; overflow: hidden; }
  .fun-bar i { display: block; height: 100%; background: var(--bond); border-radius: 99px; }
  .fun-row.warn .fun-bar i { background: var(--node); }
  .fun-row.warn .fun-name { font-weight: 600; color: var(--ink); }
  .fun-note { display: flex; gap: 10px; align-items: start; font-size: 13px; color: var(--ink-muted); margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--line-soft); }
  .fun-note .marker { margin-top: 4px; width: 9px; height: 9px; }
</style>
