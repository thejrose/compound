---
// Cumulative contribution per customer by months since first order, two segments. Example data.
const months = [0, 3, 6, 9, 12, 15, 18, 21, 24];
const a = [18, 26, 31, 35, 38, 40.5, 42.5, 44, 45.5];   // no first-order discount
const b = [12, 16, 18.5, 20, 21, 21.8, 22.3, 22.7, 23]; // 15%+ first-order discount
const W = 460, H = 210, L = 34, R = 12, T = 14, B = 30, max = 50;
const x = (i: number) => L + (i / (months.length - 1)) * (W - L - R);
const y = (v: number) => T + (1 - v / max) * (H - T - B);
const path = (s: number[]) => s.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join('');
const area = (s: number[]) => `${path(s)}L${x(s.length - 1)} ${y(0)}L${x(0)} ${y(0)}Z`;
---
<figure class="ltv">
  <div class="ltv-head">
    <span class="label">12-month contribution LTV</span>
    <div class="ltv-key"><span><i style="background:var(--block-deep)"></i>Full price first order</span><span><i style="background:var(--node)"></i>15%+ discount</span></div>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Example chart: customers acquired at full price are worth about twice as much after 24 months as customers acquired with a 15% or larger discount.">
    <defs><linearGradient id="ltv-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#9EE2BF" stop-opacity=".45" /><stop offset="1" stop-color="#9EE2BF" stop-opacity="0" /></linearGradient></defs>
    {[0, 10, 20, 30, 40, 50].map((v) => (<g><line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="#EEF0F4" /><text x={L - 8} y={y(v) + 4} text-anchor="end" class="ax">£{v}</text></g>))}
    {months.map((m, i) => (i % 2 === 0 ? <text x={x(i)} y={H - 10} text-anchor="middle" class="ax">{m}m</text> : null))}
    <path d={area(a)} fill="url(#ltv-fill)" />
    <path d={path(b)} fill="none" stroke="#F5A54A" stroke-width="2.5" stroke-linejoin="round" />
    <path d={path(a)} fill="none" stroke="#1C7A52" stroke-width="2.5" stroke-linejoin="round" />
    <circle cx={x(8)} cy={y(a[8])} r="4.5" fill="#fff" stroke="#1C7A52" stroke-width="2.5" />
    <circle cx={x(8)} cy={y(b[8])} r="4.5" fill="#fff" stroke="#F5A54A" stroke-width="2.5" />
  </svg>
</figure>
<style>
  .ltv { margin: 0; display: grid; gap: 12px; }
  .ltv-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; align-items: center; }
  .ltv-key { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12.5px; color: var(--ink-muted); }
  .ltv-key span { display: inline-flex; align-items: center; gap: 6px; }
  .ltv-key i { width: 14px; height: 3px; border-radius: 2px; }
  .ltv .ax { font: 500 10.5px var(--font-mono); fill: #8A92A3; }
</style>
