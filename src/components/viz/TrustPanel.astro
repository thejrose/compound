---
// Node and bond trust scores from the data health check. Example data.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const nodes = [
  { name: 'Shopify orders', v: 96 }, { name: 'GA4', v: 78 }, { name: 'Ad platforms', v: 64 }, { name: 'Product costs', v: 91 },
];
const bonds = [
  { name: 'Shopify ↔ GA4', v: 84 }, { name: 'Spend ↔ campaigns', v: 58 }, { name: 'Orders ↔ costs', v: 93 },
];
const tone = (v: number) => (v >= 80 ? 'var(--block)' : v >= 60 ? 'var(--node)' : '#F28B74');
---
<div class:list={['trust', { compact }]}>
  <div class="tp-head"><span class="label">Data health check</span><span class="tp-score"><b>82</b>/100</span></div>
  <div class="tp-group">
    <span class="tp-kind"><span class="marker"></span>Node trust</span>
    {nodes.map((n) => (
      <div class="tp-row"><span>{n.name}</span><span class="tp-bar"><i style={`width:${n.v}%;background:${tone(n.v)}`}></i></span><b>{n.v}</b></div>
    ))}
  </div>
  <div class="tp-group">
    <span class="tp-kind"><span class="marker" data-stage="bond"></span>Bond trust</span>
    {bonds.map((n) => (
      <div class="tp-row"><span>{n.name}</span><span class="tp-bar"><i style={`width:${n.v}%;background:${tone(n.v)}`}></i></span><b>{n.v}</b></div>
    ))}
  </div>
</div>
<style>
  .trust { display: grid; gap: 18px; font-size: 13.5px; }
  .tp-head { display: flex; justify-content: space-between; align-items: baseline; }
  .tp-score { font: 400 15px/1 var(--font-text); color: var(--ink-faint); }
  .tp-score b { font: 400 34px/1 var(--font-display); color: var(--ink); letter-spacing: -0.02em; }
  .tp-group { display: grid; gap: 9px; }
  .tp-kind { display: flex; align-items: center; gap: 8px; font: 500 11px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 2px; }
  .tp-kind .marker { width: 9px; height: 9px; }
  .tp-row { display: grid; grid-template-columns: 128px 1fr 26px; align-items: center; gap: 12px; color: var(--ink-2); }
  .tp-row b { font: 500 12.5px/1 var(--font-mono); text-align: right; color: var(--ink); }
  .tp-bar { height: 8px; border-radius: 99px; background: var(--line-soft); overflow: hidden; }
  .tp-bar i { display: block; height: 100%; border-radius: 99px; }
  .compact .tp-row { grid-template-columns: 112px 1fr 24px; }
</style>
