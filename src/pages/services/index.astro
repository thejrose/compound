---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceMap from '../../components/ServiceMap.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
---
<Base title="Services" description="Six compound. services, each built node, bond, block, and each making the others stronger: business assessment, growth strategy, conversion, customer retention, operations and analytics, fractional leadership.">
  <PageHero eyebrow="Services" title='Six services, built the same way<span class="dot">.</span>' lead="Every service starts with the nodes (your people and data), makes the bonds (the connections between them) and builds the blocks (real changes with an owner, a date and a number). Most engagements start with a business assessment." />

  <section class="section">
    <div class="wrap svc-list">
      {services.map((s) => (
        <article class="svc-row reveal">
          <div class="svc-id"><span class="svc-sym">{s.symbol}</span><span class="label">{s.no}</span></div>
          <div class="stack">
            <h2 class="h3"><a href={`/services/${s.slug}`}>{s.name}</a></h2>
            <p class="svc-promise">{s.promise}</p>
            <p class="muted">{s.forWho}</p>
          </div>
          <ul class="svc-stages">
            <li><span class="marker"></span><span>{s.node.lead}</span></li>
            <li><span class="marker" data-stage="bond"></span><span>{s.bond.lead}</span></li>
            <li><span class="marker" data-stage="block"></span><span>{s.block.lead}</span></li>
          </ul>
          <a class="btn btn-secondary btn-sm svc-go" href={`/services/${s.slug}`} aria-label={`Explore ${s.name}`}>Explore <span class="arr" aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Cross-bonds</span>
        <h2>Every service makes the others stronger.</h2>
        <p class="lead">Fourteen bonds connect the six services. Choose one to see what it connects to, and why.</p>
      </div>
      <div class="card" style="padding:clamp(24px,4vw,48px)"><ServiceMap /></div>
    </div>
  </section>

  <CtaBand heading="Not sure where to start? Start with the leaks." />
</Base>

<style>
  .svc-list { display: grid; }
  .svc-row { display: grid; grid-template-columns: 90px minmax(0, 1.1fr) minmax(0, 1fr) auto; gap: clamp(20px, 3vw, 48px); align-items: start; padding-block: 40px; border-top: 1px solid var(--line); }
  .svc-row:first-child { border-top: 0; padding-top: 0; }
  .svc-id { display: grid; gap: 10px; justify-items: start; }
  .svc-sym { width: 64px; height: 64px; display: grid; place-items: center; border-radius: 14px; background: var(--block-soft); border: 1px solid #cdebdc; font: 400 30px/1 var(--font-display); }
  .svc-row h2 a { color: var(--ink); text-decoration: none; }
  .svc-row h2 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .svc-row h2 { font-size: clamp(26px, 2.6vw, 32px); }
  .svc-promise { font-size: 18px; color: var(--ink-2); }
  .svc-stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: 15.5px; color: var(--ink-muted); }
  .svc-stages li { display: grid; grid-template-columns: 18px 1fr; gap: 10px; }
  .svc-stages .marker { margin-top: 6px; width: 10px; height: 10px; }
  @media (max-width: 960px) { .svc-row { grid-template-columns: 80px 1fr; } .svc-stages, .svc-go { grid-column: 2; } .svc-go { justify-self: start; } }
  @media (max-width: 560px) { .svc-row { grid-template-columns: 1fr; } .svc-stages, .svc-go { grid-column: 1; } }
</style>
