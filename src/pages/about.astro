---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="About" description="Why compound. exists, what the name means, and how we work.">
  <PageHero eyebrow="About" title='Separate elements, bonded into something stronger<span class="dot">.</span>' lead="That’s what a compound is, and it’s how we work. Growing businesses rarely lack talent or ideas. What they lack is someone outside the day-to-day who can see the whole picture, connect the people who hold the answers, and stay long enough to build the change." />

  <section class="section">
    <div class="wrap founder">
      <div class="placeholder f-photo"><strong>Placeholder: founder photo</strong></div>
      <div class="stack-m">
        <span class="eyebrow">The founder</span>
        <h2>Placeholder: your name<span class="dot">.</span></h2>
        <div class="placeholder"><strong>Placeholder: your story.</strong> Your background across commercial, ecommerce, marketing and customer leadership; the kinds of businesses you’ve grown; and the moment you decided to start compound.</div>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How we work</span>
        <h2>What you can expect from us.</h2>
      </div>
      <div class="grid-2 values">
        <div class="card"><h3>Say the thing.</h3><p class="muted">We lead with the finding. If your checkout is losing one order in five, we’ll say so.</p></div>
        <div class="card"><h3>Every number has an owner.</h3><p class="muted">Nothing leaves our work without a person, a date and a number to move.</p></div>
        <div class="card"><h3>Bring everyone in.</h3><p class="muted">We work with the warehouse lead as much as the CEO. Change happens where the work happens.</p></div>
        <div class="card"><h3>Trust before insight.</h3><p class="muted">We check the data before we use it, and tell you how sure we are about every finding.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="stack-m">
        <span class="eyebrow">Who we work with</span>
        <h2>Mid-market brands ready for their next phase.</h2>
      </div>
      <ul class="who-list">
        <li><span class="marker"></span>Founder-led brands scaling beyond the start-up phase</li>
        <li><span class="marker" data-stage="bond"></span>Established brands moving into, or revamping, direct-to-consumer</li>
        <li><span class="marker" data-stage="block"></span>D2C businesses unlocking their next phase of growth</li>
        <li><span class="marker" style="background:var(--ink)"></span>UK brands expanding into the US and Europe</li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .founder { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .f-photo { aspect-ratio: 4 / 5; display: grid; place-items: center; text-align: center; }
  @media (max-width: 760px) { .founder { grid-template-columns: 1fr; } .f-photo { aspect-ratio: 4 / 3; } }
  .values .card { display: grid; gap: 10px; }
  .values { align-items: stretch; }
  .who-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .who-list li { display: grid; grid-template-columns: 24px 1fr; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 18px; }
  .who-list .marker { margin-top: 7px; }
</style>
