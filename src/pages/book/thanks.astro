---
import Base from '../../layouts/Base.astro';
---
<Base title="Thanks" description="Thanks for getting in touch with compound.">
  <section class="section">
    <div class="wrap stack-l" style="max-width:760px">
      <span class="mol mol-l" aria-hidden="true"><span class="n" data-stage="bond"></span><span class="b"></span><span class="n" data-stage="bond"></span></span>
      <h1>Thanks. That’s the first bond made<span class="dot">.</span></h1>
      <p class="lead">We’ll reply within one working day to find a time that suits you.</p>
      <div><a class="btn btn-ghost" href="/services">Explore the services</a></div>
    </div>
  </section>
</Base>
