---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import TrustPanel from '../components/viz/TrustPanel.astro';
import LtvChart from '../components/viz/LtvChart.astro';
import BlockRegister from '../components/viz/BlockRegister.astro';
---
<Base title="Our approach" description="How compound. works: nodes, bonds and blocks. We understand your people and data, connect them, and build changes with an owner, a date and a number to move.">
  <PageHero eyebrow="Our approach" title='nodes<span class="dot">.</span> bonds<span class="dot">.</span> blocks<span class="dot">.</span>' lead="A compound is separate elements bonded into something stronger. Every compound. engagement follows the same three stages, so you always know what’s happening, why, and what it will deliver.">
    <div class="card hero-mol" aria-hidden="true">
      <span class="mol mol-xl"><span class="n" data-stage="node"></span><span class="b"></span><span class="n" data-stage="bond"></span><span class="b"></span><span class="k" data-stage="block"><span class="n"></span><span class="n"></span><span class="n"></span><span class="n"></span></span></span>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="feature reveal">
        <div class="stack-m">
          <span class="chip" data-stage="node"><span class="marker"></span>Stage 1 · node.</span>
          <h2>Understand each part on its own terms.</h2>
          <p class="lead">We start with people as well as data. Short interviews show who owns each number and where the team thinks the problems are. A health check then scores every data source, so you know which numbers to trust.</p>
          <ul class="ticks"><li>People and ownership interviews</li><li>Data health check: node trust scores</li><li>Customer voice: reviews, tickets, returns</li></ul>
        </div>
        <div class="card viz"><span class="example-tag">Example data</span><TrustPanel /></div>
      </div>
      <div class="feature flip reveal">
        <div class="stack-m">
          <span class="chip" data-stage="bond"><span class="marker" data-stage="bond"></span>Stage 2 · bond.</span>
          <h2>Connect what nobody has had time to connect.</h2>
          <p class="lead">The answers sit between the parts: margin joined to marketing, customers joined to products, what customers do joined to what they say. Then we bring the people who own those numbers into one room to agree what they mean.</p>
          <ul class="ticks"><li>Cohorts and lifetime value</li><li>Unit economics and true margin</li><li>Marketing efficiency, funnel and range analysis</li></ul>
        </div>
        <div class="card viz"><span class="example-tag">Example data</span><LtvChart /></div>
      </div>
      <div class="feature reveal">
        <div class="stack-m">
          <span class="chip" data-stage="block"><span class="marker" data-stage="block"></span>Stage 3 · block.</span>
          <h2>Build changes, not decks.</h2>
          <p class="lead">Every finding leaves as a block: a change with an owner, a date, a KPI and a value in pounds. Blocks backed by more evidence rank higher. Then we help your teams build them.</p>
          <ul class="ticks"><li>The block register, ranked by value, trust and evidence</li><li>Hands-on delivery across teams</li><li>A weekly trading pack to track every block</li></ul>
        </div>
        <div class="card viz"><span class="example-tag">Example data</span><BlockRegister /></div>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Our principles</span>
        <h2>Four rules we work by.</h2>
      </div>
      <div class="rules">
        <div class="card"><span class="label">01</span><h3>People are nodes too.</h3><p class="muted">No finding is reported without saying whose number it is.</p></div>
        <div class="card"><span class="label">02</span><h3>Trust before insight.</h3><p class="muted">We score every data source and every connection, and flag findings built on weak data.</p></div>
        <div class="card"><span class="label">03</span><h3>Every finding becomes a block.</h3><p class="muted">An owner, a date, a KPI and a value. Never just a recommendation.</p></div>
        <div class="card"><span class="label">04</span><h3>Strength comes from bonds.</h3><p class="muted">A change supported by several independent analyses ranks above one supported by a single analysis.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="stack-m">
        <span class="eyebrow">The compound effect</span>
        <h2>Each block makes the next one stronger.</h2>
        <p class="lead">Blocks bond across services: a better first purchase lifts repeat rate; lifetime value sets what you can spend to win a customer; clean data makes every test trustworthy. Each quarter we re-run the diagnostic, so you see progress in the same terms as the first look.</p>
        <a class="link-arrow" href="/services">See how the six services bond <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ol class="loop">
        <li><span class="marker"></span><div><h4>Diagnose</h4><p class="muted">Weeks 1–2</p></div></li>
        <li><span class="marker" data-stage="bond"></span><div><h4>Connect</h4><p class="muted">Weeks 3–4</p></div></li>
        <li><span class="marker" data-stage="block"></span><div><h4>Build</h4><p class="muted">Months 2–6</p></div></li>
        <li><span class="marker" style="background:var(--ink)"></span><div><h4>Compound</h4><p class="muted">Re-run every quarter</p></div></li>
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero-mol { display: grid; place-items: center; min-height: 260px; background: linear-gradient(135deg, #fff, var(--tint)); box-shadow: var(--shadow-3); }
  @media (max-width: 600px) { .hero-mol .mol { --mol-node: 26px; --mol-bond: 40px; --mol-line: 2px; } }
  .feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 88px); align-items: center; padding-block: clamp(32px, 4vw, 56px); }
  .feature + .feature { border-top: 1px solid var(--line); }
  .feature.flip > :first-child { order: 2; }
  .feature .stack-m { justify-items: start; }
  @media (max-width: 860px) { .feature { grid-template-columns: 1fr; } .feature.flip > :first-child { order: 0; } }
  .viz { position: relative; padding-top: 48px; }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ticks li { display: grid; grid-template-columns: 22px 1fr; gap: 8px; }
  .ticks li::before { content: "✓"; font-weight: 700; color: var(--block-deep); }
  .rules { display: grid; gap: var(--s6); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .rules .card { display: grid; gap: 12px; align-content: start; }
  @media (max-width: 960px) { .rules { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .rules { grid-template-columns: 1fr; } }
  .loop { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-left: 1.5px solid var(--line); margin-left: 8px; }
  .loop li { display: grid; grid-template-columns: 20px 1fr; gap: 16px; padding: 0 0 28px; margin-left: -8px; }
  .loop li:last-child { padding-bottom: 0; }
  .loop .marker { width: 16px; height: 16px; margin-top: 3px; }
</style>
