---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="section">
    <div class="wrap stack-l" style="max-width:760px">
      <span class="mol mol-l" aria-hidden="true"><span class="n"></span><span class="b"></span><span class="n" style="background:#fff;border-style:dashed"></span></span>
      <h1>This bond didn’t form<span class="dot">.</span></h1>
      <p class="lead">The page you’re looking for isn’t here. Try the services, or start with a conversation.</p>
      <div style="display:flex;gap:16px;flex-wrap:wrap"><a class="btn btn-primary" href="/book">Book a growth check</a><a class="btn btn-secondary" href="/services">See the services</a></div>
    </div>
  </section>
</Base>
