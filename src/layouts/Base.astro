---
import '../styles/global.css';
import { services } from '../data/services';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
const fullTitle = title === 'compound.' ? 'compound. | Ecommerce growth consultancy' : `${title} | compound.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Fraunces-100-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/InstrumentSans-400-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/brand/compound-avatar.png', Astro.site)} />
    <meta name="theme-color" content="#FFFFFF" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'compound.',
      description: 'Ecommerce growth consultancy for mid-market brands in the UK and beyond.',
      url: Astro.site?.toString(), areaServed: ['GB', 'US', 'EU'],
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand-link" href="/" aria-label="compound. home">
          <img src="/brand/compound-wordmark.svg" alt="compound." width="160" height="26" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" id="menu-btn">Menu</button>
        <nav class="nav" id="site-nav" aria-label="Main">
          <a href="/services" aria-current={current('/services')}>Services</a>
          <a href="/about" aria-current={current('/about')}>About</a>
          <a class="btn btn-primary btn-sm" href="/book">Book a growth check</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div class="stack">
            <img src="/brand/compound-wordmark.svg" alt="compound." width="140" height="23" style="height:23px;width:auto" />
            <p>Ecommerce growth consultancy for mid-market brands, in the UK and beyond.</p>
            <span class="mol mol-s" aria-hidden="true"><span class="n" data-stage="node"></span><span class="b"></span><span class="n" data-stage="bond"></span><span class="b"></span><span class="k" data-stage="block"><span class="n"></span><span class="n"></span><span class="n"></span><span class="n"></span></span></span>
          </div>
          <div>
            <span class="label">Services</span>
            <ul>
              {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}
            </ul>
          </div>
          <div>
            <span class="label">compound.</span>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="/services">How we work</a></li>
              <li><a href="/book">Book a growth check</a></li>
            </ul>
          </div>
          <div>
            <span class="label">Legal</span>
            <ul>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/cookies">Cookies</a></li>
              <li><a href="/terms">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="base">
          <span>© {year} compound. All rights reserved.</span>
          <span class="label">nodes. bonds. blocks.</span>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const nav = document.getElementById('site-nav');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav?.setAttribute('data-open', String(!open));
      });
    </script>
  </body>
</html>
