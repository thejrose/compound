---
import '../styles/global.css';
import { services } from '../data/services';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
const fullTitle = title === 'compound.' ? 'compound. | Ecommerce growth consultancy' : `${title} | compound.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Fraunces-100-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/InstrumentSans-400-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/brand/compound-avatar.png', Astro.site)} />
    <meta name="theme-color" content="#FFFFFF" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'compound.',
      description: 'Ecommerce growth consultancy for mid-market brands in the UK and beyond.',
      url: Astro.site?.toString(), areaServed: ['GB', 'US', 'EU'],
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <div class="wrap">
        <a class="brand-link" href="/" aria-label="compound. home">
          <img src="/brand/compound-wordmark.svg" alt="compound." width="166" height="27" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" id="menu-btn">Menu</button>
        <nav class="nav" id="site-nav" aria-label="Main">
          <a href="/services" aria-current={current('/services')}>Services</a>
          <a href="/approach" aria-current={current('/approach')}>Approach</a>
          <a href="/about" aria-current={current('/about')}>About</a>
          <a class="btn btn-primary btn-sm" href="/book">Book a growth check <span class="arr" aria-hidden="true">→</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer ink">
      <div class="wrap">
        <div class="cols">
          <div class="stack-m">
            <img class="foot-mark" src="/brand/compound-avatar.svg" alt="compound." width="52" height="52" />
            <p class="muted" style="max-width:32ch">Ecommerce growth consultancy for mid-market brands, in the UK and beyond.</p>
            <p class="label">nodes. bonds. blocks.</p>
          </div>
          <div>
            <span class="label">Services</span>
            <ul>{services.map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}</ul>
          </div>
          <div>
            <span class="label">compound.</span>
            <ul>
              <li><a href="/approach">Our approach</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/book">Book a growth check</a></li>
            </ul>
          </div>
          <div>
            <span class="label">Legal</span>
            <ul>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/cookies">Cookies</a></li>
              <li><a href="/terms">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="base">
          <span>© {year} compound. All rights reserved.</span>
          <span>Registered in England and Wales. [Company number]</span>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const nav = document.getElementById('site-nav');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav?.setAttribute('data-open', String(!open));
      });
      const header = document.getElementById('site-header');
      const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 8));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
